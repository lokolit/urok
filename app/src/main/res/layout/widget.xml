<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/widget_bg">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Сейчас" android:textSize="12sp" android:textColor="#B39A9B"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:layout_width="8dp" android:layout_height="40dp" android:layout_marginEnd="12dp"
            android:background="@drawable/bar_red"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/cur_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="19sp" android:textStyle="bold" android:textColor="#F1DEDB"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/cur_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="13sp" android:textColor="#F08A85" android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="14dp" android:text="Дальше" android:textSize="12sp" android:textColor="#B39A9B"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <View android:layout_width="8dp" android:layout_height="28dp" android:layout_marginEnd="12dp"
            android:background="@drawable/bar_dim"/>
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:id="@+id/nxt_name" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="15sp" android:textStyle="bold" android:textColor="#D9C3C0"
                android:maxLines="1" android:ellipsize="end"/>
            <TextView android:id="@+id/nxt_time" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#B39A9B" android:maxLines="1"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
